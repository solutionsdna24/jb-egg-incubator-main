# Apache / cPanel — SPA routing (if not on GitHub Pages)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Prefer apex canonical (matches GitHub Pages CNAME jbincubators.in)
  RewriteCond %{HTTP_HOST} ^www\.jbincubators\.in$ [NC]
  RewriteRule ^(.*)$ https://jbincubators.in/$1 [L,R=301]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
